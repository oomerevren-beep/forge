{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["cli/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
