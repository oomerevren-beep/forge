{
  "name": "tryforge",
  "version": "0.1.1",
  "description": "The Homebrew for AI Agents — one CLI for skills, MCPs, plugins, agents",
  "license": "MIT",
  "author": "Ömer Evren",
  "homepage": "https://github.com/oomerevren-beep/forge#quick-start",
  "repository": {
    "type": "git",
    "url": "https://github.com/oomerevren-beep/forge.git"
  },
  "bugs": {
    "url": "https://github.com/oomerevren-beep/forge/issues"
  },
  "keywords": [
    "package-manager",
    "homebrew",
    "ai-agents",
    "claude-code",
    "mcp",
    "skills",
    "cursor",
    "opencode",
    "codex",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "forge": "./dist/cli/src/index.js",
    "tryforge": "./dist/cli/src/index.js"
  },
  "files": [
    "dist/",
    "registry/",
    "install.sh",
    "install.ps1",
    "forge.toml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx cli/src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test && npm run registry:build -- --check",
    "test": "node --import tsx --test tests/**/*.test.ts cli/src/**/*.test.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "seed": "tsx scripts/seed-registry.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
