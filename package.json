{
  "name": "@oomerevren/tryforge",
  "version": "0.2.0",
  "description": "Forge — Universal package manager for AI agent context (skills, MCPs, rules, agents).",
  "license": "MIT",
  "author": "Ömer Evren",
  "homepage": "https://github.com/oomerevren-beep/forge#quick-start",
  "repository": {
    "type": "git",
    "url": "https://github.com/oomerevren-beep/forge.git"
  },
  "bugs": {
    "url": "https://github.com/oomerevren-beep/forge/issues"
  },
  "keywords": [
    "forge",
    "agent-context",
    "mcp",
    "skills",
    "ai-agents",
    "claude-code",
    "cursor",
    "opencode",
    "codex",
    "windsurf",
    "docker-for-context"
  ],
  "type": "module",
  "bin": {
    "forge": "./dist/index.cjs",
    "tryforge": "./dist/index.cjs"
  },
  "files": [
    "dist/",
    "registry/",
    "install.sh",
    "install.ps1",
    "forge.toml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx cli/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "esbuild cli/src/index.ts --bundle --platform=node --format=cjs --main-fields=module,main --outfile=dist/index.cjs --minify && node -e \"try{require('fs').chmodSync('dist/index.cjs',0o755)}catch{}\"",
    "lint": "eslint cli/ scripts/ tests/ eslint.config.js --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run bundle && npm test && npm run registry:build -- --check",
    "test": "node --import tsx --test tests/**/*.test.ts cli/src/**/*.test.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "seed": "tsx scripts/seed-registry.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chokidar": "^4.0.3",
    "commander": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
