{
  "name": "forge",
  "version": "0.1.0",
  "description": "The Homebrew for AI Agents — one CLI for skills, MCPs, plugins, agents",
  "type": "module",
  "bin": {
    "forge": "./cli/src/index.ts"
  },
  "scripts": {
    "dev": "bun run cli/src/index.ts",
    "build": "bun build cli/src/index.ts --outdir dist --target bun",
