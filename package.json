    "registry:build": "bun run scripts/build-registry.ts",
    "seed": "bun run scripts/seed-registry.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "flexsearch": "^0.7.0"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
}
