{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/oomerevren-beep/forge/main/schema/forge.schema.json",
  "title": "forge.toml schema — universal agent context (Docker for Context)",
  "description": "Single manifest for AI agent configuration: project meta, agent roles, skills, MCP servers, permissions. Works for both package manifests ([package]) and project files ([project]/[dependencies]/[skills]).",
  "type": "object",
  "properties": {
    "package": {
      "type": "object",
      "required": ["name", "version", "type", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+\\/[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "type": { "enum": ["skill", "agent", "command", "instruction", "mcp", "workflow", "rule", "prompt", "config", "plugin", "hook"] },
        "description": { "type": "string", "minLength": 10, "maxLength": 300 },
        "license": { "type": "string" },
        "author": { "type": "string" },
        "tier": { "enum": ["community", "verified", "trusted"] },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "harnesses": { "type": "array", "items": { "type": "string" } },
        "forge": { "type": "string" },
        "os": { "type": "array", "items": { "type": "string" } }
      }
    },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "agents": {
      "type": "object",
      "description": "Shared agent roles, e.g. [agents.developer] = { model, system_prompt }",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": { "type": "string" },
          "system_prompt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "object",
      "description": "Team skills: name = \"^1.2.0\" or { version, source, ref }",
      "additionalProperties": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "version": { "type": "string" },
              "source": { "type": "string" },
              "ref": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "mcp": {
      "type": "object",
      "description": "Package-level MCP template ([mcp]) or project servers ([mcp.servers.<name>])",
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object" },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Install-time permission boundaries enforced by forge audit/sync",
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "denied_paths": { "type": "array", "items": { "type": "string" } },
        "allow_network": { "type": "boolean" },
        "allow_env": { "type": "boolean" },
        "allow_shell": { "type": "boolean" },
        "allow_exec": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "forge": {
      "type": "object",
      "properties": {
        "harnesses": { "type": "array", "items": { "type": "string" } }
      }
    },
    "engines": { "type": "object", "additionalProperties": { "type": "string" } },
    "dependencies": { "type": "object", "additionalProperties": { "type": "string" } },
    "files": {
      "type": "object",
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
